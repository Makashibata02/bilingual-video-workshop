# Default-deny project root: only reviewed source directories/files are allowed.
/*
!/.gitignore
!/.gitattributes
!/.gitleaks.toml
!/.python-version
!/README.md
!/LICENSE
!/NOTICE.md
!/PRIVACY.md
!/SECURITY.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/requirements*.txt
!/启动App.cmd
!/app/
!/app/**
!/tests/
!/tests/**
!/scripts/
!/scripts/**
!/docs/
!/docs/**
!/.github/
!/.github/**
!/.githooks/
!/.githooks/**

# Credentials and runtime artifacts remain private even under source folders.
.local/
.venv/
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/profiles.json
**/profiles.tmp
**/settings/
**/exports/
**/downloads/
**/models/
**/bin/
**/validation/
**/runs/
**/_internal/
**/*.log
**/*.pem
**/*.crt
**/*.key
**/*.p12
**/*.pfx
**/*.exe
**/*.dll
**/*.pyd
**/*.mp4
**/*.mkv
**/*.webm
**/*.mp3
**/*.wav
**/*.zip
**/*.onnx
**/*.bin
**/*.pt
